# Committed on purpose.
#
# A browser app cannot hide a key: whatever it needs to reach Supabase ships
# inside the JavaScript bundle, which anyone can open from the live site. So
# keeping this out of the repo would hide it from us and from nobody else,
# while quietly breaking the GitHub Actions build — which has no .env and was
# producing a bundle with no cloud config at all.
#
# Supabase labels this key "safe to share publicly" for exactly that reason.
# The protection is row-level security on every table, not secrecy: without a
# signed-in user this key reads nothing and writes nothing (verified).
#
# The SECRET key is a different animal and must never appear here.
VITE_SUPABASE_URL=https://brqhcolbbbwacpclslvg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_IkQj_bwmEVt5PLNjb661YA_Wm8b95HC
